rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isFlagshipAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'sarvideleonardo@gmail.com';
    }

    // 3. Entity Validators
    function isValidCategory(category) {
      return category is string &&
        category in ['arte', 'musica', 'gastronomia', 'literatura', 'experimentos', 'personal'];
    }

    function isValidCharacterId(characterId) {
      return characterId is string &&
        characterId in ['explorador', 'melomano', 'chef', 'astronomo', 'robot404'];
    }

    function isValidTheme(theme) {
      return theme is map &&
        theme.keys().hasAll(['presetId', 'skyColor', 'oceanColor', 'accentColor', 'surfaceColor', 'roomThemeId']) &&
        theme.keys().hasOnly([
          'presetId', 'skyColor', 'oceanColor', 'accentColor', 'surfaceColor',
          'roomThemeId', 'islandStyle', 'frameStyle'
        ]) &&
        theme.presetId is string && theme.presetId.size() >= 1 && theme.presetId.size() <= 32 &&
        theme.skyColor is string && theme.skyColor.size() >= 4 && theme.skyColor.size() <= 16 &&
        theme.oceanColor is string && theme.oceanColor.size() >= 4 && theme.oceanColor.size() <= 16 &&
        theme.accentColor is string && theme.accentColor.size() >= 4 && theme.accentColor.size() <= 16 &&
        theme.surfaceColor is string && theme.surfaceColor.size() >= 4 && theme.surfaceColor.size() <= 16 &&
        theme.roomThemeId is string && theme.roomThemeId in ['classic', 'night', 'twilight', 'gameboy'] &&
        (!('islandStyle' in theme) || (theme.islandStyle is string && theme.islandStyle in ['cliffs', 'terraced', 'floating'])) &&
        (!('frameStyle' in theme) || (theme.frameStyle is string && theme.frameStyle in ['archival', 'ornate', 'minimal']));
    }

    function isValidDonationConfig(d) {
      return d is map &&
        d.keys().hasAll(['enabled', 'url', 'platformLabel', 'note']) &&
        d.keys().hasOnly(['enabled', 'url', 'platformLabel', 'note']) &&
        d.enabled is bool &&
        d.url is string && (d.url == '' || (d.url.size() <= 1000 && d.url.matches('^https?://.*'))) &&
        d.platformLabel is string && d.platformLabel.size() <= 40 &&
        d.note is string && d.note.size() <= 200;
    }

    function isValidMuseum(data) {
      return data.keys().hasAll([
          'ownerId', 'authorName', 'title', 'subtitle', 'category', 'templateId',
          'theme', 'defaultCharacterId', 'isPublic', 'islands', 'rooms',
          'islandCount', 'pieceCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'authorName', 'title', 'subtitle', 'category', 'templateId',
          'theme', 'defaultCharacterId', 'isPublic', 'islands', 'rooms',
          'islandCount', 'pieceCount', 'donationConfig', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.subtitle is string && data.subtitle.size() <= 180 &&
        isValidCategory(data.category) &&
        data.templateId is string && data.templateId.size() >= 1 && data.templateId.size() <= 40 &&
        isValidTheme(data.theme) &&
        isValidCharacterId(data.defaultCharacterId) &&
        data.isPublic is bool &&
        data.islands is list && data.islands.size() >= 1 && data.islands.size() <= 20 && data.islands[0] is map &&
        data.rooms is list && data.rooms.size() >= 1 && data.rooms.size() <= 60 && data.rooms[0] is map &&
        data.islandCount is int && data.islandCount >= 1 && data.islandCount <= 20 &&
        data.pieceCount is int && data.pieceCount >= 0 && data.pieceCount <= 500 &&
        (!('donationConfig' in data) || isValidDonationConfig(data.donationConfig)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCuratedFrom(c) {
      return c is map &&
        c.keys().hasAll(['sourceMuseumId', 'sourceMuseumTitle', 'sourceAuthorName', 'sourcePieceId', 'sourcePieceTitle']) &&
        c.keys().hasOnly(['sourceMuseumId', 'sourceMuseumTitle', 'sourceAuthorName', 'sourcePieceId', 'sourcePieceTitle']) &&
        c.sourceMuseumId is string && c.sourceMuseumId.size() >= 1 && c.sourceMuseumId.size() <= 128 &&
        c.sourceMuseumTitle is string && c.sourceMuseumTitle.size() >= 1 && c.sourceMuseumTitle.size() <= 100 &&
        c.sourceAuthorName is string && c.sourceAuthorName.size() >= 1 && c.sourceAuthorName.size() <= 80 &&
        c.sourcePieceId is string && c.sourcePieceId.size() >= 1 && c.sourcePieceId.size() <= 128 &&
        c.sourcePieceTitle is string && c.sourcePieceTitle.size() >= 1 && c.sourcePieceTitle.size() <= 120;
    }

    function isValidCuratedSource(data) {
      return !('curatedFrom' in data) || (
        isValidCuratedFrom(data.curatedFrom) && (
          (
            data.curatedFrom.sourceMuseumId == 'museo404' &&
            data.curatedFrom.sourceMuseumTitle == 'MUSEO 404 · siNOMBRE' &&
            data.curatedFrom.sourceAuthorName == 'Colección Original'
          ) || (
            isValidId(data.curatedFrom.sourceMuseumId) &&
            (
              get(/databases/$(database)/documents/museums/$(data.curatedFrom.sourceMuseumId)).data.isPublic == true ||
              get(/databases/$(database)/documents/museums/$(data.curatedFrom.sourceMuseumId)).data.ownerId == request.auth.uid
            ) &&
            get(/databases/$(database)/documents/museums/$(data.curatedFrom.sourceMuseumId)).data.title == data.curatedFrom.sourceMuseumTitle &&
            get(/databases/$(database)/documents/museums/$(data.curatedFrom.sourceMuseumId)).data.authorName == data.curatedFrom.sourceAuthorName
          )
        )
      );
    }

    function isValidPiece(data) {
      return data.keys().hasAll([
          'museumId', 'ownerId', 'islandId', 'roomId', 'title', 'subtitle', 'body',
          'kind', 'type', 'url', 'mediaDataUrl', 'isPublic', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'museumId', 'ownerId', 'islandId', 'roomId', 'title', 'subtitle', 'body',
          'kind', 'type', 'url', 'mediaDataUrl', 'isPublic', 'curatedFrom', 'loanInviteId',
          'saleStatus', 'priceLabel', 'mediumOrSize', 'paymentUrl',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.museumId) &&
        isValidId(data.ownerId) &&
        data.islandId is string && data.islandId.size() >= 1 && data.islandId.size() <= 80 &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() <= 140 &&
        data.body is string && data.body.size() <= 12000 &&
        data.kind is string && data.kind in ['text', 'painting', 'app', 'link', 'image', 'audio', 'video'] &&
        data.type is string && data.type in ['text', 'image', 'audio', 'video', 'link'] &&
        data.url is string && (data.url == '' || (data.url.size() <= 1000 && data.url.matches('^https?://.*'))) &&
        data.mediaDataUrl is string && (data.mediaDataUrl == '' || (data.mediaDataUrl.size() <= 180000 && data.mediaDataUrl.matches('^data:image/.*'))) &&
        data.isPublic is bool &&
        (!('curatedFrom' in data) || isValidCuratedFrom(data.curatedFrom)) &&
        (!('loanInviteId' in data) || isValidId(data.loanInviteId)) &&
        (!('saleStatus' in data) || (data.saleStatus is string && data.saleStatus in ['not_for_sale', 'for_sale', 'reserved', 'sold'])) &&
        (!('priceLabel' in data) || (data.priceLabel is string && data.priceLabel.size() <= 40)) &&
        (!('mediumOrSize' in data) || (data.mediumOrSize is string && data.mediumOrSize.size() <= 120)) &&
        (!('paymentUrl' in data) || (data.paymentUrl is string && (data.paymentUrl == '' || (data.paymentUrl.size() <= 1000 && data.paymentUrl.matches('^https?://.*'))))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIslandInvite(data) {
      return data.keys().hasAll([
          'museumId', 'museumTitle', 'hostUid', 'hostName', 'islandId', 'islandTitle',
          'status', 'guestUid', 'guestName', 'sourceMuseumId', 'sourceMuseumTitle',
          'sourceMuseumUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'museumId', 'museumTitle', 'hostUid', 'hostName', 'islandId', 'islandTitle',
          'status', 'guestUid', 'guestName', 'sourceMuseumId', 'sourceMuseumTitle',
          'sourceMuseumUrl', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.museumId) &&
        data.museumTitle is string && data.museumTitle.size() >= 1 && data.museumTitle.size() <= 100 &&
        isValidId(data.hostUid) &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80 &&
        data.islandId is string && data.islandId.size() >= 1 && data.islandId.size() <= 80 &&
        data.islandTitle is string && data.islandTitle.size() >= 1 && data.islandTitle.size() <= 80 &&
        data.status is string && data.status in ['pending', 'accepted', 'revoked'] &&
        (data.guestUid == null || isValidId(data.guestUid)) &&
        data.guestName is string && data.guestName.size() <= 80 &&
        data.sourceMuseumId is string && data.sourceMuseumId.size() <= 128 &&
        data.sourceMuseumTitle is string && data.sourceMuseumTitle.size() <= 100 &&
        data.sourceMuseumUrl is string && (
          data.sourceMuseumUrl == '' ||
          (data.sourceMuseumUrl.size() <= 1000 && data.sourceMuseumUrl.matches('^(\\?museum=[a-zA-Z0-9_\\-]+|https?://.*)$'))
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoanGuest(museumId, islandId, inviteId) {
      return isValidId(inviteId) &&
        get(/databases/$(database)/documents/islandInvites/$(inviteId)).data.museumId == museumId &&
        get(/databases/$(database)/documents/islandInvites/$(inviteId)).data.islandId == islandId &&
        get(/databases/$(database)/documents/islandInvites/$(inviteId)).data.guestUid == request.auth.uid &&
        get(/databases/$(database)/documents/islandInvites/$(inviteId)).data.status == 'accepted';
    }

    function isValidGuestbookEntry(data) {
      return data.keys().hasAll([
          'museumId', 'islandId', 'roomId', 'scopeLabel', 'nickname', 'message',
          'authorUid', 'isVisible', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'museumId', 'islandId', 'roomId', 'scopeLabel', 'nickname', 'message',
          'authorUid', 'isVisible', 'createdAt'
        ]) &&
        isValidId(data.museumId) &&
        data.islandId is string && data.islandId.size() >= 1 && data.islandId.size() <= 80 &&
        data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 80 &&
        data.scopeLabel is string && data.scopeLabel.size() >= 1 && data.scopeLabel.size() <= 80 &&
        data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 40 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        (data.authorUid == null || (isVerifiedUser() && data.authorUid == request.auth.uid)) &&
        data.isVisible is bool &&
        data.createdAt is timestamp;
    }

    function isValidPurchaseInquiry(data) {
      return data.keys().hasAll([
          'museumId', 'museumOwnerId', 'pieceId', 'pieceTitle', 'priceLabel',
          'buyerName', 'buyerContact', 'shippingLocation', 'message', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'museumId', 'museumOwnerId', 'pieceId', 'pieceTitle', 'priceLabel',
          'buyerName', 'buyerContact', 'shippingLocation', 'message', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.museumId) &&
        isValidId(data.museumOwnerId) &&
        data.pieceId is string && data.pieceId.size() >= 1 && data.pieceId.size() <= 128 &&
        data.pieceTitle is string && data.pieceTitle.size() >= 1 && data.pieceTitle.size() <= 120 &&
        data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 40 &&
        data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80 &&
        data.buyerContact is string && data.buyerContact.size() >= 3 && data.buyerContact.size() <= 120 &&
        data.shippingLocation is string && data.shippingLocation.size() <= 120 &&
        data.message is string && data.message.size() <= 500 &&
        data.status is string && data.status in ['pending', 'contacted', 'closed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFlagshipConfig(data) {
      return data.keys().hasAll(['theme', 'updatedAt']) &&
        data.keys().hasOnly(['theme', 'donationConfig', 'pieceCommerce', 'updatedAt']) &&
        isValidTheme(data.theme) &&
        (!('donationConfig' in data) || isValidDonationConfig(data.donationConfig)) &&
        (!('pieceCommerce' in data) || (data.pieceCommerce is map && data.pieceCommerce.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'characterId', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'characterId', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() <= 160 &&
        isValidCharacterId(data.characterId) &&
        data.updatedAt is timestamp;
    }

    // 4. Collections
    match /museums/{museumId} {
      allow get: if isValidId(museumId) && (
        existing().isPublic == true || isOwner(existing().ownerId)
      );

      allow list: if resource.data.isPublic == true || (
        request.auth != null && resource.data.ownerId == request.auth.uid
      );

      allow create: if isVerifiedUser() &&
        isValidId(museumId) &&
        isValidMuseum(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(museumId) &&
        isValidMuseum(incoming()) &&
        isOwner(existing().ownerId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().templateId == existing().templateId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'authorName', 'title', 'subtitle', 'category', 'theme', 'defaultCharacterId',
            'isPublic', 'donationConfig', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'islands', 'rooms', 'islandCount', 'pieceCount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pieceCount', 'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(museumId) &&
        isOwner(existing().ownerId);

      // Subcollection of museum pieces (Master Gate relational sync to parent museum)
      match /pieces/{pieceId} {
        allow get: if isValidId(museumId) && isValidId(pieceId) && (
          existing().isPublic == true || isOwner(existing().ownerId)
        );

        allow list: if resource.data.isPublic == true || (
          request.auth != null && resource.data.ownerId == request.auth.uid
        );

        allow create: if isVerifiedUser() &&
          isValidId(museumId) &&
          isValidId(pieceId) &&
          isValidPiece(incoming()) &&
          incoming().museumId == museumId &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isValidCuratedSource(incoming()) && (
            get(/databases/$(database)/documents/museums/$(museumId)).data.ownerId == request.auth.uid || (
              'loanInviteId' in incoming() &&
              isValidLoanGuest(museumId, incoming().islandId, incoming().loanInviteId) &&
              incoming().isPublic == get(/databases/$(database)/documents/museums/$(museumId)).data.isPublic
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(museumId) &&
          isValidId(pieceId) &&
          isValidPiece(incoming()) &&
          incoming().museumId == existing().museumId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              get(/databases/$(database)/documents/museums/$(museumId)).data.ownerId == request.auth.uid && (
                (
                  isOwner(existing().ownerId) &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'islandId', 'roomId', 'title', 'subtitle', 'body', 'kind', 'type', 'url', 'mediaDataUrl',
                    'saleStatus', 'priceLabel', 'mediumOrSize', 'paymentUrl', 'updatedAt'
                  ])
                ) ||
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'isPublic', 'updatedAt'
                ])
              )
            ) || (
              isOwner(existing().ownerId) &&
              'loanInviteId' in existing() &&
              incoming().islandId == existing().islandId &&
              incoming().loanInviteId == existing().loanInviteId &&
              isValidLoanGuest(museumId, existing().islandId, existing().loanInviteId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'roomId', 'title', 'subtitle', 'body', 'kind', 'type', 'url', 'mediaDataUrl',
                'saleStatus', 'priceLabel', 'mediumOrSize', 'paymentUrl', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidId(museumId) &&
          isValidId(pieceId) && (
            get(/databases/$(database)/documents/museums/$(museumId)).data.ownerId == request.auth.uid || (
              isOwner(existing().ownerId) &&
              'loanInviteId' in existing() &&
              isValidLoanGuest(museumId, existing().islandId, existing().loanInviteId)
            )
          );
      }
    }

    // Loaned Island Invitations (Isla Prestada: magic link + guest permissions locked to one island)
    match /islandInvites/{inviteId} {
      allow get: if isValidId(inviteId);

      allow list: if resource.data.status == 'accepted' || (
        request.auth != null && (
          resource.data.hostUid == request.auth.uid ||
          resource.data.guestUid == request.auth.uid
        )
      );

      allow create: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidIslandInvite(incoming()) &&
        incoming().hostUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().guestUid == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/museums/$(incoming().museumId)).data.ownerId == request.auth.uid;

      allow update: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidIslandInvite(incoming()) &&
        incoming().museumId == existing().museumId &&
        incoming().hostUid == existing().hostUid &&
        incoming().islandId == existing().islandId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            existing().status == 'pending' &&
            existing().guestUid == null &&
            incoming().status == 'accepted' &&
            incoming().guestUid == request.auth.uid &&
            incoming().guestName.size() >= 1 &&
            incoming().sourceMuseumTitle.size() >= 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'guestUid', 'guestName', 'sourceMuseumId', 'sourceMuseumTitle', 'sourceMuseumUrl', 'updatedAt'
            ])
          ) || (
            existing().hostUid == request.auth.uid &&
            existing().status != 'revoked' &&
            incoming().status == 'revoked' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            existing().status == 'accepted' &&
            existing().guestUid == request.auth.uid &&
            incoming().status == 'accepted' &&
            incoming().guestUid == existing().guestUid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestName', 'sourceMuseumId', 'sourceMuseumTitle', 'sourceMuseumUrl', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(inviteId) &&
        existing().hostUid == request.auth.uid;
    }

    // Open Guestbook (reception & rooms, free nickname allowed, owner moderation)
    match /guestbook/{entryId} {
      allow get: if isValidId(entryId) && (
        existing().isVisible == true || (
          isVerifiedUser() && (
            existing().museumId == 'museo404'
              ? isFlagshipAdmin()
              : get(/databases/$(database)/documents/museums/$(existing().museumId)).data.ownerId == request.auth.uid
          )
        )
      );

      allow list: if resource.data.isVisible == true ||
        (request.auth != null && resource.data.authorUid == request.auth.uid) ||
        (isVerifiedUser() && (
          resource.data.museumId == 'museo404'
            ? isFlagshipAdmin()
            : get(/databases/$(database)/documents/museums/$(resource.data.museumId)).data.ownerId == request.auth.uid
        ));

      allow create: if isValidId(entryId) &&
        isValidGuestbookEntry(incoming()) &&
        incoming().isVisible == true &&
        incoming().createdAt == request.time && (
          incoming().museumId == 'museo404' ||
          get(/databases/$(database)/documents/museums/$(incoming().museumId)).data.isPublic == true
        );

      allow update: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidGuestbookEntry(incoming()) &&
        incoming().museumId == existing().museumId &&
        incoming().islandId == existing().islandId &&
        incoming().roomId == existing().roomId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isVisible']) && (
          existing().museumId == 'museo404'
            ? isFlagshipAdmin()
            : get(/databases/$(database)/documents/museums/$(existing().museumId)).data.ownerId == request.auth.uid
        );

      allow delete: if isVerifiedUser() &&
        isValidId(entryId) && (
          (existing().authorUid != null && existing().authorUid == request.auth.uid) || (
            existing().museumId == 'museo404'
              ? isFlagshipAdmin()
              : get(/databases/$(database)/documents/museums/$(existing().museumId)).data.ownerId == request.auth.uid
          )
        );
    }

    // Strict PII-Isolated Purchase Inquiries
    match /purchaseInquiries/{inquiryId} {
      allow get: if isVerifiedUser() && isValidId(inquiryId) && (
        existing().museumId == 'museo404'
          ? isFlagshipAdmin()
          : existing().museumOwnerId == request.auth.uid
      );

      allow list: if request.auth != null && request.auth.token.email_verified == true && (
        resource.data.museumOwnerId == request.auth.uid ||
        (resource.data.museumId == 'museo404' && request.auth.token.email == 'sarvideleonardo@gmail.com')
      );

      allow create: if isValidId(inquiryId) &&
        isValidPurchaseInquiry(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (incoming().museumId == 'museo404' && incoming().museumOwnerId == 'museo404') ||
          (
            incoming().museumId != 'museo404' &&
            get(/databases/$(database)/documents/museums/$(incoming().museumId)).data.isPublic == true &&
            get(/databases/$(database)/documents/museums/$(incoming().museumId)).data.ownerId == incoming().museumOwnerId
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidPurchaseInquiry(incoming()) &&
        (
          existing().museumId == 'museo404'
            ? isFlagshipAdmin()
            : existing().museumOwnerId == request.auth.uid
        ) &&
        existing().status != 'closed' &&
        incoming().museumId == existing().museumId &&
        incoming().museumOwnerId == existing().museumOwnerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(inquiryId) && (
        existing().museumId == 'museo404'
          ? isFlagshipAdmin()
          : existing().museumOwnerId == request.auth.uid
      );
    }

    // Official Flagship Config (Theme, Donation URL, Painting Sale Statuses)
    match /flagship/{docId} {
      allow get: if docId == 'config';
      allow list: if false;

      allow create, update: if isFlagshipAdmin() &&
        docId == 'config' &&
        isValidFlagshipConfig(incoming()) &&
        incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Strict PII & Personal Preferences Split Collection
    match /users/{userId}/private/profile {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidPrivateProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidPrivateProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'characterId', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }
  }
}
